typedef struct {
    uint16_t angle1;      // Mesure potentiomètre 1
    uint16_t angle2;      // Mesure potentiomètre 2
    uint8_t  status;      // État de santé / désaccord
    uint8_t  counter;     // Compteur de trame (Rolling counter)
    uint8_t  crc;         // Code de redondance cyclique reçu
} SteerDataFrame_t;

extern CAN_HandleTypeDef hcan1;
extern TIM_HandleTypeDef htim2; // Timer utilisé pour le PWM du servomoteur

uint8_t last_received_counter = 0;
uint8_t error_counter = 0;
#define MAX_CONSECUTIVE_ERRORS 5
/* USER CODE END PV */

/* USER CODE BEGIN PFP */
uint8_t Calculate_CRC8(uint8_t *data, uint8_t length);
void Process_Steer_Command(uint16_t angle);
/* USER CODE END PFP */

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_CAN1_Init();
  MX_TIM2_Init(); // Initialisation du PWM pour le servomoteur

  /* USER CODE BEGIN 2 */
  // 1. Démarrage du PWM pour le servomoteur
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

  // 2. Configuration des filtres CAN et activation des interruptions
  CAN_FilterTypeDef sFilterConfig;
  sFilterConfig.FilterBank = 0;
  sFilterConfig.FilterMode = CAN_FILTERMODE_IDMASK;
  sFilterConfig.FilterScale = CAN_FILTERSCALE_32BIT;
  sFilterConfig.FilterIdHigh = 0x0000;
  sFilterConfig.FilterIdLow = 0x0000;
  sFilterConfig.FilterMaskIdHigh = 0x0000;
  sFilterConfig.FilterMaskIdLow = 0x0000;
  sFilterConfig.FilterFIFOAssignment = CAN_FILTER_FIFO0;
  sFilterConfig.FilterActivation = ENABLE;
  
  HAL_CAN_ConfigFilter(&hcan1, &sFilterConfig);
  HAL_CAN_Start(&hcan1);
  
  // Activer l'interruption de réception FIFO 0
  HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
  /* USER CODE END 2 */

  while (1)
  {
      // La boucle principale peut gérer le mode dégradé si le bus CAN est muet
      HAL_Delay(100);
  }
}

