// Fonction de calcul CRC-8 (identique à l'émetteur)
uint8_t Calculate_CRC8(uint8_t *data, uint8_t length) {
    uint8_t crc = 0xFF;
    for (uint8_t i = 0; i < length; i++) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x80)
                crc = (crc << 1) ^ 0x31;
            else
                crc <<= 1;
        }
    }
    return crc;
}

// Interruption de réception CAN : déclenchée dès qu'une trame arrive de l'ECU Capteur ou d'un attaquant
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan) {
    CAN_RxHeaderTypeDef rxHeader;
    uint8_t rxData[8];

    if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &rxHeader, rxData) == HAL_OK) {
        // Filtrer par ID CAN attendu (ex: 0x100)
        if (rxHeader.StdId == 0x100) {
            SteerDataFrame_t *received_frame = (SteerDataFrame_t *)rxData;

            // 1. Vérification du CRC sur les 6 premiers octets
            uint8_t calculated_crc = Calculate_CRC8(rxData, 6);

            // 2. Vérification du Compteur (Protection E2E contre le rejeu / falsification)
            // Le compteur doit s'incrémenter logiquement par rapport au précédent
            int8_t counter_diff = (int8_t)(received_frame->counter - last_received_counter);

            if ((calculated_crc == received_frame->crc) && (counter_diff > 0)) {
                // Trame VALIDE : Mise à jour du compteur de séquence
                last_received_counter = received_frame->counter;
                error_counter = 0; // Reset des erreurs

                // Choix de l'angle (redondance : si capteur 1 OK, sinon capteur 2 de secours)
                uint16_t active_angle = (received_frame->status == 0) ? received_frame->angle1 : received_frame->angle2;

                // Piloter le servomoteur avec l'angle validé
                Process_Steer_Command(active_angle);
            } 
            else {
                // Trame INVALIDE (CRC faux, trame falsifiée par un attaquant ou rupture de séquence)
                error_counter++;
                
                // Si trop d'échecs consécutifs, passage en état sûr (immobilisation du servomoteur)
                if (error_counter >= MAX_CONSECUTIVE_ERRORS) {
                    // État sûr : fixer le servomoteur en position neutre (centre)
                    Process_Steer_Command(2048); 
                }
            }
        }
    }
}

// Fonction de conversion de l'angle (0 - 4095) vers le PWM du servomoteur (ex: 1ms à 2ms)
void Process_Steer_Command(uint16_t angle) {
    // Conversion linéaire de l'ADC (0 à 4095) en impulsion Timer (ex: CCR de 500 à 2500 pour un servo standard)
    uint32_t pwm_val = 500 + ((uint32_t)angle * 2000) / 4095;
    
    // Application de la valeur sur le canal PWM du Timer
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, pwm_val);
}

